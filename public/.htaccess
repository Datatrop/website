Options -MultiViews
RewriteEngine On
RewriteBase /

# Microsoft OAuth callback -> PHP handler.
# Must come BEFORE the SPA catch-all, otherwise /auth/microsoft/callback would
# be served index.html and the sign-in would never complete.
# QSA keeps Microsoft's ?code=…&state=… query string intact.
RewriteRule ^auth/microsoft/callback/?$ api/ms_callback.php [L,QSA]

# Pre-rendered pages: /about → about.html, /what-we-do → what-we-do.html, …
# (built by scripts/prerender.mjs) so crawlers get each page's real HTML.
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# Single-page app: send everything that isn't a real file/folder to index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]

# Caching: pages must always be re-checked so visitors get a new release straight
# away; the hashed files under /assets never change, so they can be kept a year.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
